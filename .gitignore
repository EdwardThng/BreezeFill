# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Node / frontend
node_modules/
frontend/dist/

# Built by Vercel's buildCommand (frontend/dist copied here). Generated, never
# authored — the one file committed under frontend/public is the source.
/public/

# macOS. The Finder writes these into any directory it displays, so they turn
# up on their own. `_NOT_SHIPPED` in backend/main.py already keeps them out of
# the extension zip; this keeps them out of the history.
.DS_Store

# Env & secrets
.env
.env.*

# Never commit generated/filled PDFs or anything derived from patient data
forms/output/

# The zip uploaded to the Chrome Web Store. Built from extension/ on demand, so
# it is derived rather than authored — and it goes stale the moment the
# manifest version changes, which is exactly when someone would reach for a
# committed one by mistake. Rebuild it, never read it out of the history.
/breezefill-store-*.zip

.vercel
.env*
