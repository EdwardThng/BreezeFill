{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build && rm -rf public && cp -r frontend/dist public",
  "regions": ["sin1"],
  "rewrites": [{ "source": "/privacy", "destination": "/privacy.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "excludeFiles": "{frontend/**,public/**,node_modules/**,.venv/**,tests/**,docs/**,scripts/**,**/__pycache__/**,**/*.test.js,**/*.pyc}",
      "includeFiles": "{forms/**,backend/schemas/**,extension/**}"
    }
  }
}
