{
  "manifest_version": 3,
  "name": "BreezeFill",
  "version": "0.3.0",
  "description": "Fills insurer claim forms from a clinical note. Fills in place; never submits.",
  "minimum_chrome_version": "114",

  "permissions": ["activeTab", "scripting", "sidePanel"],

  "icons": {
    "16": "icons/chrome-toolbar-16.png",
    "32": "icons/chrome-toolbar-retina-32.png",
    "48": "icons/chrome-manage-page-48.png",
    "128": "icons/chrome-store-listing-128.png"
  },

  "side_panel": {
    "default_path": "panel/panel.html"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_title": "Open BreezeFill",
    "default_icon": {
      "16": "icons/chrome-toolbar-16.png",
      "32": "icons/chrome-toolbar-retina-32.png"
    }
  }
}
