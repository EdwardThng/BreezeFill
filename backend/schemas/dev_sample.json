    },
    {
      "id": "symptoms_preexisting",
      "pdf_field_name": "Check_PreExisting",
      "type": "checkbox",
      "source": "llm",
      "description": "Did symptoms exist before, or is this a pre-existing condition per the notes?"
    }
  ]
}
